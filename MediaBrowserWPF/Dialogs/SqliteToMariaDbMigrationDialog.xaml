<Window x:Class="MediaBrowserWPF.Dialogs.SqliteToMariaDbMigrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SQLite nach MariaDB migrieren"
        Width="900" Height="760" MinWidth="760" MinHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="SQLite-Quelle" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="95" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Datenbank:" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Name="SourcePathTextBox" Margin="0,3"
                         TextChanged="SourcePathTextBox_TextChanged" VerticalContentAlignment="Center" />
                <Button Grid.Row="0" Grid.Column="2" Name="BrowseSourceButton" Content="Durchsuchen..."
                        Margin="6,3,0,3" Click="BrowseSourceButton_Click" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Thumbnails:" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Name="ThumbnailPathTextBox" Margin="0,3"
                         TextChanged="ThumbnailPathTextBox_TextChanged" VerticalContentAlignment="Center" />
                <Button Grid.Row="1" Grid.Column="2" Name="BrowseThumbnailButton" Content="Durchsuchen..."
                        Margin="6,3,0,3" Click="BrowseThumbnailButton_Click" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="MariaDB-Ziel" Margin="0,10,0,0" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Host:" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Name="TargetHostTextBox" Margin="0,3" IsReadOnly="True" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Port:" VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBox Grid.Row="0" Grid.Column="3" Name="TargetPortTextBox" Margin="0,3" IsReadOnly="True" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Datenbank:" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Name="TargetDatabaseTextBox" Margin="0,3" IsReadOnly="True" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Benutzer:" VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBox Grid.Row="1" Grid.Column="3" Name="TargetUserTextBox" Margin="0,3" IsReadOnly="True" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Passwort:" VerticalAlignment="Center" />
                <PasswordBox Grid.Row="2" Grid.Column="1" Name="TargetPasswordBox" Margin="0,3"
                             PasswordChanged="TargetPasswordBox_PasswordChanged" VerticalContentAlignment="Center" />
            </Grid>
        </GroupBox>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="10" Background="#FFF4CE"
                BorderBrush="#D6B656" BorderThickness="1">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#8A1F11"
                           Text="Achtung: Alle vorhandenen Daten in der MariaDB-Zieldatenbank werden vor der Migration gelöscht. Diese Aktion kann nicht rückgängig gemacht werden." />
                <CheckBox Name="ConfirmationCheckBox" Margin="0,8,0,0"
                          Checked="Confirmation_Changed" Unchecked="Confirmation_Changed"
                          Content="Ich habe verstanden, dass die Zieldatenbank vollständig geleert wird." />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Zum Bestätigen den Datenbanknamen eingeben:" VerticalAlignment="Center" />
                    <TextBox Name="ConfirmationTextBox" Width="240" Margin="8,0,0,0"
                             TextChanged="ConfirmationTextBox_TextChanged" VerticalContentAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="3" Header="Prüfung und Protokoll" Margin="0,10,0,0" Padding="8">
            <TextBox Name="SummaryTextBox" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                     FontFamily="Consolas" FontSize="12"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" />
        </GroupBox>

        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <ProgressBar Name="MigrationProgressBar" Height="18" Minimum="0" Maximum="100" />
            <TextBlock Name="StatusTextBlock" Margin="0,5,0,0" Text="Bereit." TextWrapping="Wrap" />
            <TextBlock Name="TableStatusTextBlock" Margin="0,2,0,0" Foreground="#555555" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Name="PreflightButton" Content="Prüfen" MinWidth="95" Margin="0,0,8,0"
                    Click="PreflightButton_Click" />
            <Button Name="StartButton" Content="Migration starten" MinWidth="140" Margin="0,0,8,0"
                    IsEnabled="False" Click="StartButton_Click" />
            <Button Name="CloseButton" Content="Abbrechen" MinWidth="95" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
