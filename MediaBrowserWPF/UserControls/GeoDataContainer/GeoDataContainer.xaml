<UserControl x:Class="MediaBrowserWPF.UserControls.GeoDataContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:map="clr-namespace:MapControl"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="320"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="2">
            <Button x:Name="RefreshButton" Content="Aktualisieren" Padding="5,1" Margin="2"
                    Click="RefreshButton_Click" />
            <Button x:Name="ShowAllButton" Content="Alle anzeigen" Padding="5,1" Margin="2"
                    Click="ShowAllButton_Click" />
            <Button x:Name="LargeMapButton" Content="Großansicht" Padding="5,1" Margin="2"
                    Click="LargeMapButton_Click" />
            <CheckBox x:Name="CheckBoxSingles" Content="Einzelpunkte" IsChecked="True"
                      VerticalAlignment="Center" Margin="6,0,2,0"
                      Checked="OptionsChanged" Unchecked="OptionsChanged" />
            <ComboBox x:Name="ComboBoxSort" Width="130" Margin="2" SelectionChanged="ListOptionsChanged" />
        </WrapPanel>

        <Border Grid.Row="1" BorderBrush="{x:Static SystemColors.ActiveBorderBrush}"
                BorderThickness="1" Background="{x:Static SystemColors.AppWorkspaceBrush}">
            <Grid ClipToBounds="True">
                <map:MapCanvas x:Name="mapCanvas" />
                <map:NavigationControls Map="{Binding ElementName=mapCanvas}" />
                <Border x:Name="MapUnavailable" Background="#CCFFFFFF" Visibility="Collapsed">
                    <TextBlock Text="Geodaten-Suche ist nur im API-Modus verfügbar."
                               TextWrapping="Wrap" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Margin="16" TextAlignment="Center" />
                </Border>
                <TextBlock x:Name="LoadingText" Text="Lade Geodaten ..." Background="#CCFFFFFF"
                           Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Top"
                           Margin="0,8,0,0" Visibility="Collapsed" />
                <TextBlock Margin="5,2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           FontSize="9" Background="#99FFFFFF">
                    <Run Text="© " />
                    <Hyperlink NavigateUri="https://www.openstreetmap.org/"
                               RequestNavigate="OnHyperlinkRequestNavigate">OpenStreetMap</Hyperlink>
                    <Run Text=" contributors" />
                </TextBlock>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" />

        <ListView x:Name="ListViewItems" Grid.Row="3" SelectionMode="Single"
                  MouseDoubleClick="ListViewItems_MouseDoubleClick"
                  SelectionChanged="ListViewItems_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Datei" Width="180" DisplayMemberBinding="{Binding Filename}" />
                    <GridViewColumn Header="Datum" Width="120" DisplayMemberBinding="{Binding MediaDateText}" />
                    <GridViewColumn Header="Koordinaten" Width="150" DisplayMemberBinding="{Binding Coordinates}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Bereit." />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
